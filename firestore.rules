rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document and personal data
    match /users/{userId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      
      // User personal subcollections (favorites, pantry, history, preferences, shoppingList, feedback)
      match /{document=**} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

