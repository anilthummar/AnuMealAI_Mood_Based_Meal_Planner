# AnuMealAI Environment Variables Example
# Copy this file to .env or pass flags via --dart-define

# RevenueCat Public API Keys
REVENUECAT_API_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxxxxxxxx
REVENUECAT_API_KEY_ANDROID=goog_xxxxxxxxxxxxxxxxxxxxxxxxxx

# AI LLM Recipe Generation Backend (Optional - defaults to offline local generator)
AI_API_BASE_URL=https://api.anumealai.com
AI_API_KEY=your_optional_api_key_here
